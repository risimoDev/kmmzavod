# /etc/amnezia/amneziawg/awg0.conf — ШАБЛОН СТРУКТУРЫ, не готовый к копипасте.
# Jc/Jmin/Jmax/S1/S2/H1-H4 и PrivateKey сгенерируйте установщиком на сервере
# (см. README.md) — используя одинаковые примерные числа у всех
# инсталляций легко фингерпринтится DPI.

[Interface]
PrivateKey = <сгенерировано установщиком>
Address = 10.13.13.1/24
ListenPort = 51820
Jc = <сгенерировано установщиком>
Jmin = <сгенерировано установщиком>
Jmax = <сгенерировано установщиком>
S1 = <сгенерировано установщиком>
S2 = <сгенерировано установщиком>
H1 = <сгенерировано установщиком>
H2 = <сгенерировано установщиком>
H3 = <сгенерировано установщиком>
H4 = <сгенерировано установщиком>

# Один пир на каждый домашний ПК с фермой.
[Peer]
PublicKey = <публичный ключ домашнего ПК>
AllowedIPs = 10.13.13.2/32

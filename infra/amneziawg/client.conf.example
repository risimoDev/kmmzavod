# Импортировать в официальный AmneziaWG клиент для Windows (домашний ПК).
# Jc/Jmin/Jmax/S1/S2/H1-H4 ДОЛЖНЫ совпадать с теми, что сервер сгенерировал
# у себя (см. server.conf.example / README.md) — это общий параметр
# обфускации протокола, а не отдельный секрет клиента.

[Interface]
PrivateKey = <ключ, сгенерированный на этом ПК>
Address = 10.13.13.2/32
Jc = <как на сервере>
Jmin = <как на сервере>
Jmax = <как на сервере>
S1 = <как на сервере>
S2 = <как на сервере>
H1 = <как на сервере>
H2 = <как на сервере>
H3 = <как на сервере>
H4 = <как на сервере>

[Peer]
PublicKey = <публичный ключ сервера>
Endpoint = <публичный IP или домен сервера>:51820
AllowedIPs = 10.13.13.1/32
PersistentKeepalive = 25
